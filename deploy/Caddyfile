# Caddy لمنصة نقلة: HTTPS تلقائي، ترويسات الأمان، وسجلات بلا أسرار.
# لوحة نقلة على console.<PLATFORM_DOMAIN>، وكل متجر في sites/<slug>.caddy (يولّده deploy/naqla.mjs).
{
	email {$ACME_EMAIL}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
		-X-Powered-By
		-Server
	}
}

# سجل الوصول بلا رمز الدخول (otp) ولا التوكنات والكوكيز (M2)
(access_log) {
	log {
		output file /data/logs/access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format filter {
			request>uri query {
				delete otp
			}
			request>headers>Authorization delete
			request>headers>Cookie delete
			resp_headers>Set-Cookie delete
			wrap json
		}
	}
}

# ===== لوحة نقلة الرئيسية: لا تضمين في إطار، ولا فهرسة =====
{$CONSOLE_DOMAIN} {
	import security
	import access_log
	header X-Frame-Options "DENY"
	header Content-Security-Policy "frame-ancestors 'none'"
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy console:7000
}

# ===== المتاجر =====
import /etc/caddy/sites/*.caddy
