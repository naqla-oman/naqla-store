# Naqla Store Platform — backend environment
# انسخ هذا الملف إلى .env وعدّل القيم لكل متجر/عميل
MEDUSA_ADMIN_ONBOARDING_TYPE=default
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
COOKIE_SECRET=change-me
AUTH_MFA_ENCRYPTION_KEY=change-me
DATABASE_URL=postgres://naqla:naqla@localhost:5432/naqla_layan
# ملف بيانات المتجر داخل data/ (بدون الامتداد) — يُستخدم عند أول تهيئة
STORE_DATA=layan

# ===== ثواني (Thawani) =====
# يبقى معطّلاً حتى يتوفر حساب تاجر. للتجربة على البيئة التجريبية (UAT) ضع true مع المفاتيح العامة من وثائق ثواني:
#   THAWANI_SECRET_KEY=rRQ26GcsZzoEhbrP2HZvLYDbn9C9et
#   THAWANI_PUBLISHABLE_KEY=HGvTMLDssJghr9tlN9gr4DVYt0qyBy
THAWANI_ENABLED=false
THAWANI_MODE=uat
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
STOREFRONT_URL=http://localhost:8000

# ===== دخول الزبونات برمز واتساب =====
# سر توقيع رموز الدخول (32 حرفاً عشوائياً على الأقل): openssl rand -hex 32
PHONE_AUTH_SECRET=change-me-to-a-long-random-secret
# WhatsApp Business (Meta Cloud API) — معطّل حتى يتوفر الحساب.
# عند التعطيل: يُكتب الرمز في سجل الخادم أثناء التطوير فقط، ويُرفض الدخول في الإنتاج.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# قالب من فئة Authentication معتمد في Meta، بمتغير للرمز وزر «نسخ الرمز»
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=ar
# قوالب إشعارات الطلبات (فئة Utility، لغة ar) — المتغيرات بالترتيب:
#   order_placed:       {{1}} الاسم، {{2}} رقم الطلب، {{3}} الإجمالي، {{4}} رابط التتبّع
#   order_shipped:      {{1}} الاسم، {{2}} رقم الطلب، {{3}} رابط التتبّع
#   order_ready_pickup: {{1}} الاسم، {{2}} رقم الطلب، {{3}} اسم المشغل
#   order_delivered:    {{1}} الاسم، {{2}} رقم الطلب
# القالب غير المضبوط لا يُرسل ولا يعطّل الطلب (يُسجَّل تحذير فقط).
WHATSAPP_TPL_ORDER_PLACED=
WHATSAPP_TPL_ORDER_SHIPPED=
WHATSAPP_TPL_ORDER_READY_PICKUP=
WHATSAPP_TPL_ORDER_DELIVERED=
