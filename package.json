{
  "name": "naqla-store",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@naqla/backend",
    "backend:dev": "turbo dev --filter=@naqla/backend",
    "storefront:dev": "turbo dev --filter=@naqla/storefront",
    "store:new": "node scripts/store-new.mjs",
    "store:setup": "node scripts/store-setup.mjs",
    "store:dev": "node scripts/store-dev.mjs",
    "console:setup": "pnpm --filter @naqla/console run setup",
    "console:dev": "pnpm --filter @naqla/console run dev",
    "console:worker": "pnpm --filter @naqla/console run worker",
    "test:console": "node scripts/test-console.mjs",
    "test:i18n": "node scripts/test-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0",
      "postcss": ">=8.5.12",
      "lodash": ">=4.18.0",
      "@grpc/grpc-js": ">=1.14.5",
      "brace-expansion@<2": ">=1.1.20 <2",
      "sharp": ">=0.35.0",
      "brace-expansion@>=4 <6": ">=5.0.11 <6"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "pg": "8.20.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}
